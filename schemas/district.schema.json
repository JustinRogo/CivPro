{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "district",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "name": {
      "type": "string"
    },
    "collections": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "supported": {
      "type": "boolean"
    },
    "readerMode": {
      "enum": [
        "structured",
        "source"
      ]
    }
  },
  "required": [
    "id",
    "name",
    "collections",
    "supported"
  ],
  "additionalProperties": false
}
