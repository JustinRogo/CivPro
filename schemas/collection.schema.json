{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "collection",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "name": {
      "type": "string"
    },
    "shortName": {
      "type": "string"
    },
    "districtId": {
      "type": "string",
      "minLength": 1
    },
    "scopeNote": {
      "type": [
        "string",
        "null"
      ]
    },
    "count": {
      "type": "integer",
      "minimum": 0
    },
    "editions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "collectionId": {
            "type": "string",
            "minLength": 1
          },
          "sourceDocumentId": {
            "type": "string",
            "minLength": 1
          },
          "label": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "searchPath": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "collectionId",
          "sourceDocumentId",
          "label",
          "path",
          "searchPath"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "id",
    "name",
    "shortName",
    "districtId",
    "scopeNote",
    "count",
    "editions"
  ],
  "additionalProperties": false
}
